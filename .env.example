# Copy this file to .env and fill in the values: .env is never committed.
# `make config` shows what the application reads.


# ---------------------------------------------------------------------------
# To fill in: the keys, the passwords, and how many events to collect
# ---------------------------------------------------------------------------

# Open Agenda API key: https://openagenda.com/settings/apiKey
OPENAGENDA_API_KEY=

# Mistral API key: https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# The password of the elastic user of Elasticsearch, set by `make docker-up`
# and used by the application: any long random string, for instance
# python -c "import secrets; print(secrets.token_urlsafe(24))"
ELASTIC_PASSWORD=

# The password `make docker-up` gives kibana_system, the built-in user Kibana
# reaches Elasticsearch as: another long random string. Only compose reads it.
KIBANA_PASSWORD=

# How many events `make fetch` collects: a number (200 is enough while
# developing), or all. Required: the collection refuses to run without it.
MAX_EVENTS=all


# ---------------------------------------------------------------------------
# The settings of this environment. The choices of the design (chunks,
# models) are not settings: they are the same everywhere.
# ---------------------------------------------------------------------------

# The user the application signs in to Elasticsearch as: elastic, the built-in
# superuser of compose.yaml, on a laptop; a user limited to the events indices
# elsewhere.
ELASTIC_USER=elastic

# The alias the index of the events is served under.
ELASTICSEARCH_INDEX=events

# Whether this machine can run the reranker: the rerank extra (`make
# install`), its model (`make models`, about 2.3 GB) and 2 to 3 GB of memory.
# false where it cannot: `make models` then leaves its model out.
RERANK_AVAILABLE=true

# The requests per minute the Mistral plan allows its chat models, for the
# answers: 2 on the free plan (the x-ratelimit-limit-req-minute header of its
# answers), the calls spaced to keep to it.
LLM_REQUESTS_PER_MINUTE=2


# ---------------------------------------------------------------------------
# Where this machine reaches the services, for `make`: compose gives its
# containers their own addresses. These values fit the ports compose
# publishes; change them for a service elsewhere.
# ---------------------------------------------------------------------------

ELASTICSEARCH_URL=http://127.0.0.1:9200


# ---------------------------------------------------------------------------
# Docker compose
# ---------------------------------------------------------------------------

# Read by compose.yaml only, required: the version of the Elastic images (the
# Python client in pyproject.toml stays on the same major version).
ELASTIC_VERSION=9.5.5
