# The environment of `uv sync` and the caches inside it.
.venv/

# The bytecode Python writes beside the modules.
__pycache__/

# The local settings and secrets.
.env

# The collected events; only the benchmark of data/ is versioned.
data/raw/
data/processed/

# The HTML coverage report.
htmlcov/

# The folder settings macOS Finder writes.
.DS_Store

# Editor settings.
.vscode/
