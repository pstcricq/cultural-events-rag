# The environment of `uv sync` and the caches inside it.
.venv/

# The bytecode Python writes beside the modules.
__pycache__/

# The secrets and the local settings: .env.example shows them.
.env

# The events as each API returns them.
data/raw/

# The HTML report of `make coverage ARGS="--cov-report=html"`.
htmlcov/

# The folder settings macOS Finder writes.
.DS_Store

# The settings of each one's editor: local, never shared.
.vscode/
